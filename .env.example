# Database Configuration
POSTGRES_DB=tutor_db
POSTGRES_USER=tutor_user
POSTGRES_PASSWORD=tutor_password_123
POSTGRES_PORT=5432

# Backend Service Configuration
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tutor_db

# AI Service Configuration
AI_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000

# Object Storage (MinIO, tương thích S3)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=englishpath
S3_ACCESS_KEY=minio_user
S3_SECRET_KEY=minio_password_123

# AI Service: LLM (LLM_API_KEY bắt buộc — thiếu thì endpoint quiz/chat trả 502)
# LLM_PROVIDER: "openai" (mặc định, gọi chat/completions OpenAI-compatible)
# hoặc "anthropic" (gọi Messages API native — dùng khi endpoint trả định
# dạng Anthropic native. LLM_BASE_URL append /v1/messages tự động).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Base URL endpoint LLM. Provider openai: OpenAI-compatible (Ollama, LM
# Studio, OpenRouter, vLLM...; trống → api.openai.com). Provider
# anthropic: gốc của Messages API (trống → api.anthropic.com).
LLM_BASE_URL=
LLM_MONTHLY_BUDGET_USD=10
AI_TIMEOUT_SECONDS=60

# Rocket.Chat — chỉ dùng khi chạy: docker compose --profile messaging up -d
# Pin LTS và MongoDB tương thích; không dùng tag latest.
ROCKETCHAT_VERSION=8.9.1
ROCKETCHAT_MONGODB_VERSION=8.0
ROCKETCHAT_NATS_VERSION=2.11-alpine
ROCKETCHAT_PORT=3001
ROCKETCHAT_MONGODB_PORT=27018
ROCKETCHAT_ROOT_URL=http://localhost:3001
ROCKETCHAT_DISABLE_STATISTICS_REPORTING=false

# Thay toàn bộ giá trị dưới đây trong .env local/secret store ở production.
ROCKETCHAT_CREATE_TOKENS_SECRET=replace-with-a-long-random-secret
ROCKETCHAT_ADMIN_USERNAME=ep_admin
ROCKETCHAT_ADMIN_PASSWORD=replace-with-a-strong-password
ROCKETCHAT_ADMIN_NAME=EnglishPath Admin
ROCKETCHAT_ADMIN_EMAIL=admin@englishpath.local

# Google OAuth cho tài khoản phụ huynh (Authorization Code + PKCE).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URIS=http://localhost:5173/auth/google/callback

# Backend nhắn tin (MSG): backend gọi Rocket.Chat bằng tài khoản admin trên; không cấp token cho trình duyệt.
ROCKETCHAT_URL=http://localhost:3001
MESSAGING_INTERNAL_HMAC_SECRET=replace-with-a-long-random-secret
MESSAGING_JOBS_ENABLED=true
