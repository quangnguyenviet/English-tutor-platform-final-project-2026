# Database Configuration
POSTGRES_DB=tutor_db
POSTGRES_USER=tutor_user
POSTGRES_PASSWORD=tutor_password_123
POSTGRES_PORT=5432

# Backend Service Configuration
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tutor_db

# AI Service Configuration
AI_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000

# Object Storage (MinIO, tương thích S3)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=englishpath
S3_ACCESS_KEY=minio_user
S3_SECRET_KEY=minio_password_123

# AI Service: LLM (LLM_API_KEY bắt buộc — thiếu thì endpoint quiz/chat trả 502)
# LLM_PROVIDER: "openai" (mặc định, gọi chat/completions OpenAI-compatible)
# hoặc "anthropic" (gọi Messages API native — dùng khi endpoint trả định
# dạng Anthropic native. LLM_BASE_URL append /v1/messages tự động).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Base URL endpoint LLM. Provider openai: OpenAI-compatible (Ollama, LM
# Studio, OpenRouter, vLLM...; trống → api.openai.com). Provider
# anthropic: gốc của Messages API (trống → api.anthropic.com).
LLM_BASE_URL=
LLM_MONTHLY_BUDGET_USD=10
AI_TIMEOUT_SECONDS=60
