---
title: EnglishPath - Thiết kế cơ sở dữ liệu
---
classDiagram
    direction LR

    %% ===== TÀI KHOẢN & NGƯỜI DÙNG =====
    class users {
        PK id
        username
        email
        phone
        password_hash
        full_name
        role
        status
        must_change_password
        avatar_url
        created_at
    }
    class receptionists {
        PK id
        FK user_id
        employee_code
        hired_date
        status
    }
    class parents {
        PK id
        full_name
        phone
        email
    }
    class students {
        PK id
        FK user_id
        FK parent_id
        full_name
        dob
        address
        school
        current_grade
        learning_goal
        elo
        status
        created_at
    }

    %% ===== HỒ SƠ GIA SƯ =====
    class tutor_profiles {
        PK id
        FK user_id
        FK reviewed_by
        dob
        gender
        address
        university
        major
        education_status
        bio
        experience_years
        intro_video_url
        status
        reject_reason
        submitted_at
        reviewed_at
    }
    class tutor_certificates {
        PK id
        FK tutor_id
        cert_type
        score
        issued_date
        file_url
    }
    class tutor_specialties {
        PK id
        FK tutor_id
        specialty
        grade_level
    }
    class tutor_prices {
        PK id
        FK tutor_id
        teaching_mode
        program
        price_per_hour
    }
    class tutor_availabilities {
        PK id
        FK tutor_id
        weekday
        shift
        start_time
        end_time
    }
    class tutor_service_areas {
        PK id
        FK tutor_id
        province
        district
    }
    class tutor_achievements {
        PK id
        FK tutor_id
        title
        description
    }

    %% ===== YÊU CẦU & GHÉP LỚP =====
    class tutor_requests {
        PK id
        code
        FK parent_id
        FK created_by
        parent_name
        parent_phone
        student_name
        grade
        class_requirement
        teaching_mode
        fee_per_session
        sessions_per_week
        schedule_note
        tutor_requirement
        status
        cancel_reason
        published_at
        created_at
    }
    class tutor_request_applications {
        PK id
        FK tutor_request_id
        FK tutor_id
        message
        applied_at
    }
    class match_requests {
        PK id
        code
        source_type
        FK tutor_request_id
        FK tutor_id
        FK parent_id
        FK student_id
        FK handled_by
        parent_name
        parent_phone
        student_name
        class_name
        sessions_per_week
        session_duration
        teaching_mode
        tuition_fee
        status
        cancel_reason
        created_at
    }

    %% ===== LỚP HỌC & BUỔI HỌC =====
    class classes {
        PK id
        code
        FK match_request_id
        FK tutor_id
        FK student_id
        name
        teaching_mode
        address
        online_link
        status
        trial_date
        trial_start_time
        trial_end_time
        start_date
        created_at
    }
    class class_schedules {
        PK id
        FK class_id
        weekday
        start_time
        end_time
        teaching_mode
        location
        effective_date
    }
    class sessions {
        PK id
        FK class_id
        session_no
        title
        session_date
        start_time
        end_time
        duration
        status
        status_reason
        log_knowledge
        log_homework
        log_published_at
    }
    class session_materials {
        PK id
        FK session_id
        FK uploaded_by
        file_name
        file_url
        file_type
        uploaded_at
    }

    %% ===== QUIZ & ELO =====
    class skills {
        PK id
        name
        description
    }
    class quizzes {
        PK id
        FK session_id
        FK tutor_id
        FK student_id
        title
        source
        status
        deadline
        assigned_at
        completed_at
    }
    class quiz_questions {
        PK id
        FK quiz_id
        FK skill_id
        order_no
        content
        option_a
        option_b
        option_c
        option_d
        correct_option
        explanation
        cefr_level
    }
    class quiz_answers {
        PK id
        FK quiz_id
        FK question_id
        FK student_id
        selected_option
        is_correct
        elo_change
        answered_at
    }
    class student_skill_stats {
        PK id
        FK student_id
        FK skill_id
        correct_count
        wrong_count
        last_reviewed_at
    }
    class review_items {
        PK id
        FK student_id
        FK question_id
        added_at
        reviewed_at
    }
    class ai_chat_messages {
        PK id
        FK session_id
        FK tutor_id
        role
        content
        attachment_url
        created_at
    }

    %% ===== TÀI CHÍNH & KHIẾU NẠI =====
    class payments {
        PK id
        FK class_id
        FK payer_id
        FK reviewed_by
        payer_type
        tuition_first_month
        fee_rate
        amount
        proof_url
        status
        resubmit_reason
        submitted_at
        reviewed_at
    }
    class complaints {
        PK id
        code
        FK class_id
        FK received_by
        FK resolved_by
        complainant_name
        complainant_phone
        complainant_role
        complaint_type
        content
        refund_amount
        status
        resolution_note
        received_at
        resolved_at
    }
    class complaint_attachments {
        PK id
        FK complaint_id
        file_url
        uploaded_at
    }

    %% ===== HỆ THỐNG =====
    class notifications {
        PK id
        FK user_id
        title
        content
        notification_type
        link
        is_read
        created_at
    }
    class audit_logs {
        PK id
        FK actor_id
        action
        entity_type
        entity_id
        detail
        created_at
    }

    %% ===== QUAN HỆ =====
    users "1" --> "0..1" receptionists
    users "1" --> "0..1" tutor_profiles
    users "1" --> "0..1" students : phụ huynh dùng chung
    parents "1" --> "0..*" students

    tutor_profiles "1" --> "0..*" tutor_certificates
    tutor_profiles "1" --> "0..*" tutor_specialties
    tutor_profiles "1" --> "0..*" tutor_prices
    tutor_profiles "1" --> "0..*" tutor_availabilities
    tutor_profiles "1" --> "0..*" tutor_service_areas
    tutor_profiles "1" --> "0..*" tutor_achievements

    parents "1" --> "0..*" tutor_requests
    receptionists "1" --> "0..*" tutor_requests : tạo
    tutor_requests "1" --> "0..*" tutor_request_applications
    tutor_profiles "1" --> "0..*" tutor_request_applications : ứng tuyển

    tutor_requests "1" --> "0..*" match_requests : chọn gia sư
    tutor_profiles "1" --> "0..*" match_requests
    parents "1" --> "0..*" match_requests
    receptionists "1" --> "0..*" match_requests : xử lý

    match_requests "1" --> "0..1" classes
    tutor_profiles "1" --> "0..*" classes
    students "1" --> "0..*" classes
    classes "1" --> "0..*" class_schedules
    classes "1" --> "0..*" sessions
    sessions "1" --> "0..*" session_materials

    sessions "1" --> "0..*" quizzes
    students "1" --> "0..*" quizzes
    quizzes "1" --> "1..*" quiz_questions
    skills "1" --> "0..*" quiz_questions
    quiz_questions "1" --> "0..*" quiz_answers
    students "1" --> "0..*" quiz_answers
    students "1" --> "0..*" student_skill_stats
    skills "1" --> "0..*" student_skill_stats
    students "1" --> "0..*" review_items
    quiz_questions "1" --> "0..*" review_items
    sessions "1" --> "0..*" ai_chat_messages

    classes "1" --> "0..*" payments
    users "1" --> "0..*" payments : nộp
    receptionists "1" --> "0..*" payments : duyệt
    classes "1" --> "0..*" complaints
    receptionists "1" --> "0..*" complaints : tiếp nhận
    complaints "1" --> "0..*" complaint_attachments

    users "1" --> "0..*" notifications
    users "1" --> "0..*" audit_logs
